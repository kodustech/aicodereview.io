# Content API — see CONTENT-API.md
# Bearer token required by POST /api/posts. Generate with: openssl rand -hex 32
CONTENT_API_KEY=

# Optional: when set, accepted posts are committed to GitHub (production mode),
# which triggers the deploy pipeline. Without it, posts are written to the local
# filesystem (dev mode). Token needs `contents: write` on the repo.
GITHUB_TOKEN=
GITHUB_REPO=kodustech/aicodereview.io
GITHUB_BRANCH=main
