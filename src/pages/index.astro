---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ToolDirectory from '../components/ToolDirectory.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import { getRankedTools, TOOL_CATEGORY_LABELS, TOOL_CATEGORY_BLURBS, scoreTool, monogram, monogramHue } from '../lib/tools';
import { buildPairs } from '../lib/compare';
import { editorsPicks } from '../lib/picks';
import { getPublishedPosts, CATEGORY_LABELS, formatDate, SITE_URL } from '../lib/blog';

const tools = await getRankedTools();
const posts = (await getPublishedPosts()).slice(0, 4);
const pillars = (await getCollection('pillars')).sort((a, b) => a.data.order - b.data.order);
const glossary = await getCollection('glossary');
const guides = (await getCollection('learn')).sort((a, b) => a.data.order - b.data.order);

const lastVerified = tools.map((t) => t.data.lastVerified).sort().at(-1);
const categories = [...new Set(tools.map((t) => t.data.category))];
const topTools = tools.slice(0, 12);
const picks = editorsPicks(tools);

const postSlugs = new Set((await getPublishedPosts()).map((p) => p.id));
const featuredPairs = buildPairs(tools, postSlugs).slice(0, 8);

const selfHostable = tools.filter((t) => t.data.selfHosted === 'full').length;
const openSource = tools.filter((t) => t.data.openSource).length;

const title = "AI Code Review Tools (2026) — Directory, Scores & Comparisons | aicodereview.io";
const description = `All ${tools.length} AI code review tools, scored against one public 9-pillar standard. Pricing, licensing, self-hosting and model control — every fact sourced and dated. Last verified ${lastVerified}.`;

const faq = [
	{
		q: 'What is the best AI code review tool in 2026?',
		a: `There is no single best one — it depends on which of the 9 standards your team actually needs. This directory ranks ${tools.length} tools by how much of that baseline each vendor's own documentation backs up, and shows the full matrix so you can re-rank on the pillars that matter to you. As of ${lastVerified}, ${tools[0].data.name} leads on documented coverage at ${scoreTool(tools[0]).score}/9.`,
	},
	{
		q: 'How is the coverage score calculated?',
		a: 'Each tool is mapped against 9 standards with four values: documented (1 point), partial (0.5), not offered (0) and undocumented (0). The sum is the score out of 9. Undocumented counts as zero on purpose — a capability nobody can find in the docs is one a buyer cannot rely on. The full formula and the sources are public.',
	},
	{
		q: 'Which AI code review tools can be self-hosted?',
		a: `${selfHostable} of the ${tools.length} tools in this directory document full self-hosting on their standard plans; several more offer it only on an enterprise contract. If code cannot leave your network, filter the directory by self-hosting before you compare anything else.`,
	},
	{
		q: 'Are there open-source AI code review tools?',
		a: `Yes — ${openSource} of the ${tools.length} tools here publish their source. Open source and self-hostable are not the same thing, and the licence matters: some are permissive, some copyleft, some dual-licensed with commercial-only files.`,
	},
	{
		q: 'How often is this directory updated?',
		a: `Every tool carries the date its facts were last checked against the vendor's own documentation — currently ${lastVerified} across the directory. Pricing and plan changes are the most common corrections; the dataset is public, so a stale row can be reported and fixed directly.`,
	},
];
---

<Layout
	title={title}
	description={description}
	width="wide"
	schemas={[
		{
			"@type": "ItemList",
			"name": "AI Code Review Tools Directory 2026",
			"description": description,
			"numberOfItems": tools.length,
			"itemListOrder": "https://schema.org/ItemListOrderDescending",
			"itemListElement": tools.map((tool, i) => ({
				"@type": "ListItem",
				"position": i + 1,
				"url": `${SITE_URL}/tools/${tool.id}/`,
				"name": tool.data.name,
			})),
		},
		{
			"@type": "FAQPage",
			"mainEntity": faq.map((item) => ({
				"@type": "Question",
				"name": item.q,
				"acceptedAnswer": { "@type": "Answer", "text": item.a },
			})),
		},
	]}
>
	<section class="mb-12">
		<p class="eyebrow mb-4">The AI Code Review Directory · Updated {lastVerified}</p>
		<h1 class="text-4xl md:text-6xl font-extrabold tracking-tighter text-balance text-stone-900 dark:text-zinc-50 leading-[0.95] mb-6 max-w-4xl">
			Every AI code review tool, measured against <span class="text-accent-600 dark:text-accent-400">one public standard</span>.
		</h1>
		<p class="text-lg md:text-xl text-stone-600 dark:text-zinc-400 text-pretty leading-relaxed max-w-3xl mb-8">
			No star ratings and no affiliate rankings. {tools.length} tools mapped against <a href="/standards/" class="underline underline-offset-4 decoration-accent-600 decoration-2">9 engineering standards</a> —
			pricing, licence, self-hosting, model control — each with the source it came from and the date we checked it.
		</p>

		<div class="flex flex-wrap items-center gap-3 mb-10">
			<button type="button" data-search-open class="btn-solid">
				Search the directory
				<kbd class="font-mono border border-current/40 px-1.5 py-0.5 text-[10px]">/</kbd>
			</button>
			<a href="/compare/" class="btn-ghost">Compare two tools</a>
			<a href="/methodology/" class="btn-ghost">How we score</a>
		</div>

		<dl class="grid grid-cols-2 md:grid-cols-4 border-t border-b hairline divide-x divide-stone-200 dark:divide-zinc-800">
			{[
				{ k: 'Tools tracked', v: tools.length },
				{ k: 'Standards scored', v: 9 },
				{ k: 'Self-hostable', v: selfHostable },
				{ k: 'Open source', v: openSource },
			].map((stat) => (
				<div class="py-5 px-4 first:pl-0">
					<dd class="text-3xl font-extrabold tracking-tighter text-stone-900 dark:text-zinc-100 tabular-nums">{stat.v}</dd>
					<dt class="eyebrow mt-1">{stat.k}</dt>
				</div>
			))}
		</dl>
	</section>

	<section class="mb-20">
		<div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
			<h2 class="text-2xl font-bold tracking-tight text-stone-900 dark:text-zinc-100">Editor's picks</h2>
			<p class="text-sm text-stone-500 dark:text-zinc-500 text-pretty max-w-xl">
				One pick per dimension, each the highest-scoring tool that qualifies. The ranked list below is pure arithmetic — this strip is where we choose which dimension leads.
			</p>
		</div>
		<div class="grid md:grid-cols-2 gap-4">
			{picks.map((pick, i) => (
				<a
					href={`/tools/${pick.tool.id}/`}
					class:list={[
						'panel panel-hover p-5 group relative flex gap-4',
						i === 0 && 'md:col-span-2 border-accent-600/50 dark:border-accent-500/40 bg-accent-50/50 dark:bg-accent-900/10',
					]}
				>
					<span
						class="shrink-0 w-11 h-11 border flex items-center justify-center font-mono text-xs font-bold"
						style={`border-color: hsl(${monogramHue(pick.tool.id)} 45% 55% / 0.5); background: hsl(${monogramHue(pick.tool.id)} 60% 55% / 0.10); color: hsl(${monogramHue(pick.tool.id)} 45% 38%);`}
						aria-hidden="true"
					>{monogram(pick.tool.data.name)}</span>
					<span class="min-w-0">
						<span class="block eyebrow text-accent-700 dark:text-accent-400 mb-1.5">{pick.label}</span>
						<span class="flex items-baseline gap-2 mb-1.5">
							<span class="font-bold text-lg text-stone-900 dark:text-zinc-100 group-hover:underline underline-offset-4 decoration-accent-600 decoration-2">
								{pick.tool.data.name}
							</span>
							<span class="font-mono text-xs text-stone-500 dark:text-zinc-500 tabular-nums">{scoreTool(pick.tool).score}/9</span>
						</span>
						<span class="block text-sm text-stone-600 dark:text-zinc-400 text-pretty leading-relaxed">{pick.reason}</span>
					</span>
				</a>
			))}
		</div>
	</section>

	<section class="mb-20">
		<div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
			<h2 class="text-2xl font-bold tracking-tight text-stone-900 dark:text-zinc-100">The directory</h2>
			<p class="text-sm text-stone-500 dark:text-zinc-500 text-pretty max-w-xl">
				Ranked by documented coverage of the 9 standards. Filter it, then open any tool for the sourced matrix behind its score.
			</p>
		</div>
		<ToolDirectory tools={tools} />
	</section>

	<section class="mb-20 pt-12 border-t hairline">
		<h2 class="text-2xl font-bold tracking-tight text-stone-900 dark:text-zinc-100 mb-2">Top {topTools.length} at a glance</h2>
		<p class="text-sm text-stone-500 dark:text-zinc-400 mb-8 max-w-2xl text-pretty">
			The same data as the cards above, in one scannable table. Coverage is capability documented by the vendor, not review quality — read <a href="/methodology/" class="underline underline-offset-4">the methodology</a> before treating it as a verdict.
		</p>
		<ComparisonTable tools={topTools} caption={`Top ${topTools.length} AI code review tools by documented coverage`} />
	</section>

	<section class="mb-20 pt-12 border-t hairline">
		<div class="flex flex-wrap items-baseline justify-between gap-3 mb-8">
			<h2 class="text-2xl font-bold tracking-tight text-stone-900 dark:text-zinc-100">Head to head</h2>
			<a href="/compare/" class="text-sm font-medium text-stone-600 dark:text-zinc-400 hover:text-stone-900 dark:hover:text-zinc-100">All comparisons →</a>
		</div>
		<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
			{featuredPairs.map((pair) => (
				<a href={`/compare/${pair.slug}/`} class="panel panel-hover p-4 group">
					<span class="eyebrow block mb-2">Comparison</span>
					<span class="font-bold text-stone-900 dark:text-zinc-100 group-hover:underline underline-offset-4 decoration-accent-600 decoration-2 text-balance block">
						{pair.a.data.name} <span class="text-stone-400 dark:text-zinc-600 font-normal">vs</span> {pair.b.data.name}
					</span>
					<span class="font-mono text-xs text-stone-500 dark:text-zinc-500 mt-2 block tabular-nums">
						{scoreTool(pair.a).score}/9 · {scoreTool(pair.b).score}/9
					</span>
				</a>
			))}
		</div>
	</section>

	<section class="mb-20 pt-12 border-t hairline">
		<h2 class="text-2xl font-bold tracking-tight text-stone-900 dark:text-zinc-100 mb-8">Browse by category</h2>
		<div class="grid md:grid-cols-2 gap-4">
			{categories.map((cat) => {
				const catTools = tools.filter((t) => t.data.category === cat);
				return (
					<a href={`/tools/category/${cat}/`} class="panel panel-hover p-5 group">
						<div class="flex items-baseline justify-between gap-3 mb-2">
							<h3 class="font-bold text-stone-900 dark:text-zinc-100 group-hover:underline underline-offset-4 decoration-accent-600 decoration-2">
								{TOOL_CATEGORY_LABELS[cat]}
							</h3>
							<span class="font-mono text-xs text-stone-400 dark:text-zinc-600 tabular-nums shrink-0">{catTools.length} tools</span>
						</div>
						<p class="text-sm text-stone-600 dark:text-zinc-400 text-pretty leading-relaxed mb-3">{TOOL_CATEGORY_BLURBS[cat]}</p>
						<p class="font-mono text-xs text-stone-500 dark:text-zinc-500 truncate">{catTools.slice(0, 4).map((t) => t.data.name).join(' · ')}</p>
					</a>
				);
			})}
			<a href="/tools/self-hosted/" class="panel panel-hover p-5 group">
				<div class="flex items-baseline justify-between gap-3 mb-2">
					<h3 class="font-bold text-stone-900 dark:text-zinc-100 group-hover:underline underline-offset-4 decoration-accent-600 decoration-2">Self-hosted</h3>
					<span class="font-mono text-xs text-stone-400 dark:text-zinc-600 tabular-nums shrink-0">{selfHostable} tools</span>
				</div>
				<p class="text-sm text-stone-600 dark:text-zinc-400 text-pretty leading-relaxed">Reviewers that run inside your own network, for teams whose code cannot leave it.</p>
			</a>
			<a href="/tools/open-source/" class="panel panel-hover p-5 group">
				<div class="flex items-baseline justify-between gap-3 mb-2">
					<h3 class="font-bold text-stone-900 dark:text-zinc-100 group-hover:underline underline-offset-4 decoration-accent-600 decoration-2">Open source</h3>
					<span class="font-mono text-xs text-stone-400 dark:text-zinc-600 tabular-nums shrink-0">{openSource} tools</span>
				</div>
				<p class="text-sm text-stone-600 dark:text-zinc-400 text-pretty leading-relaxed">Tools whose source you can read, audit and fork before you trust them with your codebase.</p>
			</a>
		</div>
	</section>

	<section class="mb-20 pt-12 border-t hairline">
		<div class="flex flex-wrap items-baseline justify-between gap-3 mb-8">
			<h2 class="text-2xl font-bold tracking-tight text-stone-900 dark:text-zinc-100">From the blog</h2>
			<a href="/blog/" class="text-sm font-medium text-stone-600 dark:text-zinc-400 hover:text-stone-900 dark:hover:text-zinc-100">All posts →</a>
		</div>
		<div class="grid md:grid-cols-2 gap-x-10 gap-y-8">
			{posts.map((post) => (
				<a href={`/blog/${post.id}/`} class="block group">
					<div class="flex items-center gap-3 mb-2 eyebrow">
						<span>{CATEGORY_LABELS[post.data.category] ?? post.data.category}</span>
						<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
					</div>
					<h3 class="text-lg font-bold tracking-tight text-balance text-stone-900 dark:text-zinc-100 mb-2 group-hover:underline decoration-accent-600 decoration-2 underline-offset-4">
						{post.data.title}
					</h3>
					<p class="text-sm text-stone-600 dark:text-zinc-400 text-pretty leading-relaxed">{post.data.description}</p>
				</a>
			))}
		</div>
	</section>

	<section class="mb-20 pt-12 border-t hairline grid md:grid-cols-3 gap-4">
		<a href="/standards/" class="panel panel-hover p-6 group">
			<span class="eyebrow block mb-3">The standard</span>
			<h2 class="font-bold text-lg text-stone-900 dark:text-zinc-100 mb-2 group-hover:underline underline-offset-4 decoration-accent-600 decoration-2">9 pillars</h2>
			<p class="text-sm text-stone-600 dark:text-zinc-400 text-pretty leading-relaxed">{pillars.length} standards every AI code reviewer should meet, and why each one exists. This is what the scores are measured against.</p>
		</a>
		<a href="/learn/" class="panel panel-hover p-6 group">
			<span class="eyebrow block mb-3">Learn</span>
			<h2 class="font-bold text-lg text-stone-900 dark:text-zinc-100 mb-2 group-hover:underline underline-offset-4 decoration-accent-600 decoration-2">{guides.length} guides</h2>
			<p class="text-sm text-stone-600 dark:text-zinc-400 text-pretty leading-relaxed">Long-form guides on running code review well — process, metrics, security, scale — independent of which tool you buy.</p>
		</a>
		<a href="/glossary/" class="panel panel-hover p-6 group">
			<span class="eyebrow block mb-3">Reference</span>
			<h2 class="font-bold text-lg text-stone-900 dark:text-zinc-100 mb-2 group-hover:underline underline-offset-4 decoration-accent-600 decoration-2">{glossary.length} terms</h2>
			<p class="text-sm text-stone-600 dark:text-zinc-400 text-pretty leading-relaxed">Plain definitions for the vocabulary vendors use — from cyclomatic complexity to BYOK — with what it means when you are buying.</p>
		</a>
	</section>

	<section class="mb-20 pt-12 border-t hairline">
		<h2 class="text-2xl font-bold tracking-tight text-stone-900 dark:text-zinc-100 mb-8">Common questions</h2>
		<div class="grid md:grid-cols-2 gap-x-10 gap-y-8">
			{faq.map((item) => (
				<div>
					<h3 class="font-bold text-stone-900 dark:text-zinc-100 mb-2 text-balance">{item.q}</h3>
					<p class="text-sm text-stone-600 dark:text-zinc-400 leading-relaxed text-pretty">{item.a}</p>
				</div>
			))}
		</div>
	</section>

	<section class="pt-12 border-t-2 border-stone-900 dark:border-zinc-100 flex flex-col md:flex-row justify-between items-center gap-6">
		<div class="text-center md:text-left">
			<p class="font-bold text-stone-900 dark:text-zinc-100 mb-1">Score your own setup, not just the vendors'</p>
			<p class="text-sm text-stone-500 dark:text-zinc-400">The same 9 standards, turned into a 10-minute readiness assessment.</p>
		</div>
		<a href="/assessment/" class="btn-solid w-full md:w-auto">Take the assessment [↗]</a>
	</section>
</Layout>
