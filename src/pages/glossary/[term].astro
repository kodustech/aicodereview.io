---
import { render, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getTerms, GLOSSARY_CATEGORY_LABELS } from '../../lib/glossary';
import { getRankedTools, scoreTool } from '../../lib/tools';
import { getPublishedPosts, SITE_URL } from '../../lib/blog';

export async function getStaticPaths() {
	const terms = await getTerms();
	return terms.map((term) => ({ params: { term: term.id }, props: { term, terms } }));
}

const { term, terms } = Astro.props;
const { Content } = await render(term);
const d = term.data;

const related = terms.filter((t) => d.related.includes(t.id));
const tools = await getRankedTools();
const relatedTools = tools.filter((t) => d.relatedTools.includes(t.id));
const posts = await getPublishedPosts();
const relatedPosts = posts.filter((p) => d.relatedPosts.includes(p.id));
const guides = (await getCollection('learn')).sort((a, b) => a.data.order - b.data.order);

const url = `${SITE_URL}/glossary/${term.id}/`;
const title = `${d.term}: Definition & Why It Matters (2026) | aicodereview.io`;
const description = d.definition.slice(0, 200);
---

<Layout
	title={title}
	description={description}
	ogImage={`glossary/${term.id}`}
	breadcrumbs={[
		{ name: 'Home', url: `${SITE_URL}/` },
		{ name: 'Glossary', url: `${SITE_URL}/glossary/` },
		{ name: d.term, url },
	]}
	schemas={[{
		"@type": "DefinedTerm",
		"name": d.term,
		"description": d.definition,
		"url": url,
		...(d.aliases.length ? { "alternateName": d.aliases } : {}),
		"inDefinedTermSet": {
			"@type": "DefinedTermSet",
			"name": "AI Code Review Glossary",
			"url": `${SITE_URL}/glossary/`,
		},
	}]}
>
	<Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Glossary', href: '/glossary/' }, { name: d.term }]} />

	<article>
		<p class="eyebrow mb-4">{GLOSSARY_CATEGORY_LABELS[d.category] ?? d.category} · Updated {d.updated}</p>
		<h1 class="text-4xl md:text-5xl font-extrabold tracking-tighter text-balance text-stone-900 dark:text-zinc-50 mb-5 leading-none">
			{d.term}
		</h1>
		<p class="text-lg md:text-xl text-stone-700 dark:text-zinc-300 text-pretty leading-relaxed border-l-4 border-accent-600 dark:border-accent-500 pl-5 py-1 mb-4">
			{d.definition}
		</p>
		{d.aliases.length > 0 && (
			<p class="eyebrow mb-10">Also called: {d.aliases.join(' · ')}</p>
		)}

		<div class="prose dark:prose-invert prose-stone max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-stone-900 dark:prose-a:text-zinc-100 prose-a:decoration-accent-600 prose-a:underline-offset-4 prose-p:text-pretty prose-p:leading-relaxed prose-li:text-pretty mt-10">
			<Content />
		</div>
	</article>

	{relatedTools.length > 0 && (
		<section class="mt-16 pt-10 border-t hairline">
			<h2 class="eyebrow mb-5">[ Tools where this matters ]</h2>
			<div class="grid sm:grid-cols-2 gap-4">
				{relatedTools.map((tool) => (
					<a href={`/tools/${tool.id}/`} class="panel panel-hover p-4 group">
						<span class="font-bold text-stone-900 dark:text-zinc-100 group-hover:underline underline-offset-4 decoration-accent-600 decoration-2">{tool.data.name}</span>
						<span class="font-mono text-xs text-stone-400 dark:text-zinc-600 ml-2 tabular-nums">{scoreTool(tool).score}/9</span>
						<span class="block text-sm text-stone-600 dark:text-zinc-400 mt-1 text-pretty line-clamp-2">{tool.data.tagline}</span>
					</a>
				))}
			</div>
		</section>
	)}

	{related.length > 0 && (
		<section class="mt-12">
			<h2 class="eyebrow mb-5">[ Related terms ]</h2>
			<div class="flex flex-wrap gap-2">
				{related.map((t) => (
					<a href={`/glossary/${t.id}/`} class="chip">{t.data.term}</a>
				))}
			</div>
		</section>
	)}

	{(relatedPosts.length > 0 || guides.length > 0) && (
		<section class="mt-12">
			<h2 class="eyebrow mb-5">[ Read next ]</h2>
			<ul class="space-y-2">
				{relatedPosts.map((p) => (
					<li>
						<a href={`/blog/${p.id}/`} class="text-stone-700 dark:text-zinc-300 hover:text-stone-900 dark:hover:text-zinc-100 hover:underline underline-offset-4 decoration-accent-600">{p.data.title}</a>
					</li>
				))}
				{guides.slice(0, 2).map((g) => (
					<li>
						<a href={`/learn/${g.id}/`} class="text-stone-700 dark:text-zinc-300 hover:text-stone-900 dark:hover:text-zinc-100 hover:underline underline-offset-4 decoration-accent-600">{g.data.title}</a>
					</li>
				))}
			</ul>
		</section>
	)}

	<div class="mt-16 pt-10 border-t-2 border-stone-900 dark:border-zinc-100 flex flex-col md:flex-row justify-between items-center gap-6">
		<div class="text-center md:text-left">
			<p class="font-bold text-stone-900 dark:text-zinc-100 mb-1">See which tools actually deliver this</p>
			<p class="text-sm text-stone-500 dark:text-zinc-400">Scored against 9 standards, with the source for every claim.</p>
		</div>
		<a href="/#directory" class="btn-solid w-full md:w-auto">Open the directory [↗]</a>
	</div>
</Layout>
