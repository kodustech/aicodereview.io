---
import ScoreMeter from './ScoreMeter.astro';
import PlatformIcon from './PlatformIcon.astro';
import {
	scoreTool,
	monogram,
	monogramHue,
	priceLabel,
	platformLabel,
	TOOL_CATEGORY_LABELS,
	SELF_HOSTED_SHORT,
	type Tool,
} from '../lib/tools';

interface Props {
	tool: Tool;
	/** Competition rank — tied tools share it. */
	rank?: number;
	/** True when this rank is shared, rendered as "=2". */
	tied?: boolean;
	/** Unique position, used only as the client-side sort key. */
	order?: number;
}

const { tool, rank, tied = false, order } = Astro.props;
const d = tool.data;
const score = scoreTool(tool);
const hue = monogramHue(tool.id);

// Everything the client-side filters and the inline search box read.
const search = [d.name, d.tagline, TOOL_CATEGORY_LABELS[d.category], d.license, d.platforms.map(platformLabel).join(' ')]
	.join(' ')
	.toLowerCase();
---

<article
	class="panel panel-hover group relative flex flex-col p-5"
	data-tool
	data-category={d.category}
	data-selfhosted={d.selfHosted}
	data-oss={String(d.openSource)}
	data-freetier={d.freeTier}
	data-platforms={d.platforms.join(' ')}
	data-score={score.score}
	data-rank={order ?? rank ?? 0}
	data-name={d.name.toLowerCase()}
	data-search={search}
>
	<div class="flex items-start gap-3 mb-3">
		<span
			class="shrink-0 w-10 h-10 border flex items-center justify-center font-mono text-xs font-bold"
			style={`border-color: hsl(${hue} 45% 55% / 0.5); background: hsl(${hue} 60% 55% / 0.10); color: hsl(${hue} 45% 38%);`}
			aria-hidden="true"
		>{monogram(d.name)}</span>

		<div class="min-w-0 flex-1">
			<h3 class="font-bold tracking-tight text-stone-900 dark:text-zinc-100 leading-tight">
				<a href={`/tools/${tool.id}/`} class="after:absolute after:inset-0 group-hover:underline underline-offset-4 decoration-accent-600 dark:decoration-accent-400 decoration-2">
					{d.name}
				</a>
			</h3>
			<p class="eyebrow mt-1 normal-case tracking-normal">
				{TOOL_CATEGORY_LABELS[d.category]} · {d.openSource ? d.license.split('(')[0].trim() : 'Proprietary'}
			</p>
		</div>

		{rank !== undefined && (
			<span class="shrink-0 font-mono text-[10px] text-stone-400 dark:text-zinc-600 tabular-nums" title={tied ? `Joint ${rank} — tied on score` : undefined}>
				{tied ? '=' : '#'}{rank}
			</span>
		)}
	</div>

	<p class="text-sm text-stone-600 dark:text-zinc-400 leading-relaxed text-pretty mb-4 line-clamp-3">
		{d.tagline}
	</p>

	<div class="mt-auto space-y-3">
		<div class="flex items-center gap-3">
			<ScoreMeter score={score} />
			{d.platforms.length > 0 && (
				<span class="flex items-center gap-1.5 text-stone-400 dark:text-zinc-600 ml-auto">
					{d.platforms.slice(0, 5).map((p) => <PlatformIcon platform={p} size={14} />)}
				</span>
			)}
		</div>

		<div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[11px] font-mono text-stone-500 dark:text-zinc-500">
			<span>{SELF_HOSTED_SHORT[d.selfHosted]}</span>
			<span aria-hidden="true">·</span>
			<span>{priceLabel(tool)}</span>
			{d.openSource && (
				<>
					<span aria-hidden="true">·</span>
					<span class="text-accent-700 dark:text-accent-400">Open source</span>
				</>
			)}
		</div>
	</div>
</article>
