---
import ScoreMeter from './ScoreMeter.astro';
import { rankWithTies } from '../lib/picks';
import {
	scoreTool,
	priceLabel,
	TOOL_CATEGORY_LABELS,
	SELF_HOSTED_SHORT,
	FREE_TIER_LABELS,
	type Tool,
} from '../lib/tools';

interface Props {
	tools: Tool[];
	caption?: string;
}

const { tools, caption } = Astro.props;
const ranked = rankWithTies(tools);
---

<div class="overflow-x-auto -mx-6 px-6">
	<table class="w-full min-w-[46rem] text-sm border-collapse">
		{caption && <caption class="sr-only">{caption}</caption>}
		<thead>
			<tr class="border-b-2 border-stone-900 dark:border-zinc-100">
				<th scope="col" class="text-left py-3 pr-4 eyebrow">#</th>
				<th scope="col" class="text-left py-3 pr-4 eyebrow">Tool</th>
				<th scope="col" class="text-left py-3 pr-4 eyebrow">Coverage</th>
				<th scope="col" class="text-left py-3 pr-4 eyebrow">Self-hosting</th>
				<th scope="col" class="text-left py-3 pr-4 eyebrow">Licence</th>
				<th scope="col" class="text-left py-3 pr-4 eyebrow">Free tier</th>
				<th scope="col" class="text-left py-3 eyebrow">From</th>
			</tr>
		</thead>
		<tbody>
			{ranked.map(({ tool, rank, tied }) => {
				const score = scoreTool(tool);
				return (
					<tr class="border-b hairline hover:bg-stone-100/60 dark:hover:bg-zinc-900/60 transition-colors">
						<td class="py-3 pr-4 font-mono text-xs text-stone-400 dark:text-zinc-600 tabular-nums" title={tied ? `Joint ${rank} — tied on score` : undefined}>{tied ? '=' : ''}{rank}</td>
						<td class="py-3 pr-4">
							<a href={`/tools/${tool.id}/`} class="font-bold text-stone-900 dark:text-zinc-100 hover:underline underline-offset-4 decoration-accent-600 decoration-2">
								{tool.data.name}
							</a>
							<span class="block text-xs text-stone-500 dark:text-zinc-500 mt-0.5">{TOOL_CATEGORY_LABELS[tool.data.category]}</span>
						</td>
						<td class="py-3 pr-4"><ScoreMeter score={score} /></td>
						<td class="py-3 pr-4 text-stone-600 dark:text-zinc-400 font-mono text-xs">{SELF_HOSTED_SHORT[tool.data.selfHosted]}</td>
						<td class="py-3 pr-4 text-stone-600 dark:text-zinc-400 font-mono text-xs">{tool.data.openSource ? 'Open source' : 'Proprietary'}</td>
						<td class="py-3 pr-4 text-stone-600 dark:text-zinc-400 font-mono text-xs">{FREE_TIER_LABELS[tool.data.freeTier]}</td>
						<td class="py-3 text-stone-600 dark:text-zinc-400 font-mono text-xs">{priceLabel(tool)}</td>
					</tr>
				);
			})}
		</tbody>
	</table>
</div>
