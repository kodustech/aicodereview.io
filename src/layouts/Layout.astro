---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';

interface Props {
	title: string;
	description?: string;
	breadcrumbs?: Array<{ name: string; url: string }>;
	ogType?: 'website' | 'article';
	article?: { pubDate: Date; updatedDate?: Date; tags?: string[] };
	schemas?: Record<string, unknown>[];
	/** `prose` for reading pages, `wide` for the directory and comparison grids. */
	width?: 'prose' | 'wide';
	/** Path under /og/, without extension — e.g. "tools/kodus". Falls back to the default card. */
	ogImage?: string;
}

const SITE = 'https://aicodereview.io';
const canonicalURL = new URL(Astro.url.pathname, SITE);
const {
	title,
	description = "Every AI code review tool, mapped against one public 9-pillar standard: pricing, licensing, self-hosting and model control, each with a source and a verification date.",
	breadcrumbs,
	ogType = 'website',
	article,
	schemas = [],
	width = 'prose',
	ogImage: ogImagePath,
} = Astro.props;
// Per-page cards are generated into public/og by `npm run og`.
const ogImage = `${SITE}/og/${ogImagePath ?? 'default'}.png`;
const mainWidth = width === 'wide' ? 'max-w-6xl' : 'max-w-4xl';

const publisher = {
	"@type": "Organization",
	"@id": `${SITE}/#organization`,
	"name": "aicodereview.io",
	"url": SITE,
	"description": "A directory and standard for evaluating AI code review tools.",
	"logo": { "@type": "ImageObject", "url": `${SITE}/favicon-192x192.png` },
	"sameAs": ["https://github.com/kodustech/aicodereview.io"],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonicalURL.href} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL.href} />
		{article && <meta property="article:published_time" content={article.pubDate.toISOString()} />}
		{article?.updatedDate && <meta property="article:modified_time" content={article.updatedDate.toISOString()} />}
		{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
		<meta property="og:site_name" content="aicodereview.io" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Schema.org JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@graph": [
				publisher,
				{
					"@type": "WebSite",
					"@id": `${SITE}/#website`,
					"name": "aicodereview.io",
					"url": SITE,
					"publisher": { "@id": `${SITE}/#organization` },
					"potentialAction": {
						"@type": "SearchAction",
						"target": { "@type": "EntryPoint", "urlTemplate": `${SITE}/tools/?q={search_term_string}` },
						"query-input": "required name=search_term_string"
					}
				}
			]
		})} />
		{breadcrumbs && (
			<script type="application/ld+json" set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "BreadcrumbList",
				"itemListElement": breadcrumbs.map((item, i) => ({
					"@type": "ListItem",
					"position": i + 1,
					"name": item.name,
					"item": item.url
				}))
			})} />
		)}
		{schemas.map((schema) => (
			<script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...schema })} />
		))}
		<link rel="alternate" type="application/rss+xml" title="aicodereview.io blog" href="/rss.xml" />

		<!-- Fonts: Space Grotesk & JetBrains Mono -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&family=Space+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">

		<!-- Theme: resolved before first paint to avoid a flash. -->
		<script is:inline>
			(() => {
				const stored = localStorage.getItem('theme');
				const dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.classList.toggle('dark', dark);
			})();
		</script>

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-W28X7LDJXQ"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-W28X7LDJXQ');
		</script>
	</head>
	<body class="min-h-dvh flex flex-col">
		<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-[110] focus:top-3 focus:left-3 focus:px-4 focus:py-2 focus:bg-stone-900 focus:text-stone-50">Skip to content</a>

		<Header />

		<main id="main" class:list={['flex-1 w-full mx-auto px-6 py-12 md:py-16', mainWidth]}>
			<slot />
		</main>

		<Footer />
		<SearchOverlay />

		<script is:inline>
			document.querySelectorAll('[data-theme-toggle]').forEach((btn) =>
				btn.addEventListener('click', () => {
					const dark = document.documentElement.classList.toggle('dark');
					localStorage.setItem('theme', dark ? 'dark' : 'light');
				})
			);
		</script>
	</body>
</html>
