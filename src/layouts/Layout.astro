---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	breadcrumbs?: Array<{ name: string; url: string }>;
	ogType?: 'website' | 'article';
	article?: { pubDate: Date; updatedDate?: Date; tags?: string[] };
	schemas?: Record<string, unknown>[];
}

const canonicalURL = new URL(Astro.url.pathname, 'https://aicodereview.io');
const { title, description = "The 2026 engineering standard for evaluating AI Code Review tools. 9 pillars every AI code reviewer must meet to ship faster, safer code.", breadcrumbs, ogType = 'website', article, schemas = [] } = Astro.props;
const ogImage = "https://aicodereview.io/og-image.png";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonicalURL.href} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL.href} />
		{article && <meta property="article:published_time" content={article.pubDate.toISOString()} />}
		{article?.updatedDate && <meta property="article:modified_time" content={article.updatedDate.toISOString()} />}
		{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
		<meta property="og:site_name" content="aicodereview.io" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Schema.org JSON-LD -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "WebSite",
			"name": "AI Code Review Standards",
			"url": "https://aicodereview.io",
			"description": "The 2026 engineering standard for evaluating AI Code Review tools. 9 pillars every AI code reviewer must meet to ship faster, safer code.",
			"publisher": {
				"@type": "Organization",
				"name": "aicodereview.io",
				"url": "https://aicodereview.io/about/"
			}
		})} />
		{breadcrumbs && (
			<script type="application/ld+json" set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "BreadcrumbList",
				"itemListElement": breadcrumbs.map((item, i) => ({
					"@type": "ListItem",
					"position": i + 1,
					"name": item.name,
					"item": item.url
				}))
			})} />
		)}
		{schemas.map((schema) => (
			<script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...schema })} />
		))}
		<link rel="alternate" type="application/rss+xml" title="aicodereview.io blog" href="/rss.xml" />
		
		<!-- Fonts: Space Grotesk & JetBrains Mono -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&family=Space+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-W28X7LDJXQ"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-W28X7LDJXQ');
		</script>
	</head>
	<body class="min-h-dvh flex flex-col">
		<header class="border-b border-stone-200 dark:border-zinc-800 bg-stone-50/80 dark:bg-zinc-950/80 backdrop-blur-md sticky top-0 z-50">
			<div class="max-w-4xl mx-auto px-6 py-4 flex items-center justify-between">
				<a href="/" class="font-mono text-sm tracking-tight font-bold text-stone-900 dark:text-zinc-100 uppercase">
					[ aicodereview.io ]
				</a>
				<nav class="flex items-center gap-5 md:gap-6">
					<a href="/#standards" class="text-sm font-medium text-stone-600 dark:text-zinc-400 hover:text-stone-900 dark:hover:text-zinc-100 transition-colors">Standards</a>
					<a href="/blog" class="text-sm font-medium text-stone-600 dark:text-zinc-400 hover:text-stone-900 dark:hover:text-zinc-100 transition-colors">Blog</a>
					<a href="/assessment" class="text-sm font-medium text-stone-600 dark:text-zinc-400 hover:text-stone-900 dark:hover:text-zinc-100 transition-colors">Assessment</a>
					<a href="/tools" class="text-sm font-medium text-stone-600 dark:text-zinc-400 hover:text-stone-900 dark:hover:text-zinc-100 transition-colors">Tools</a>
				</nav>
			</div>
		</header>
		
		<main class="flex-1 w-full max-w-4xl mx-auto px-6 py-16 md:py-24">
			<slot />
		</main>

		<footer class="border-t border-stone-200 dark:border-zinc-800 py-12 mt-auto bg-stone-100 dark:bg-zinc-900">
			<div class="max-w-4xl mx-auto px-6">
				<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
					<div>
						<p class="text-sm text-stone-500 dark:text-zinc-400 font-mono">
							An open engineering standard for AI code review.
						</p>
						<p class="text-xs text-stone-400 dark:text-zinc-500 mt-2 text-pretty">
							Sponsored by <a href="https://kodus.io" target="_blank" rel="noopener sponsored" class="underline underline-offset-2 hover:text-stone-600 dark:hover:text-zinc-300 transition-colors">Kodus</a> · <a href="/about" class="underline underline-offset-2 hover:text-stone-600 dark:hover:text-zinc-300 transition-colors">About this site</a>
						</p>
					</div>
					<div class="flex gap-4">
						<a href="/blog" class="text-sm font-medium text-stone-600 dark:text-zinc-400 hover:text-stone-900 dark:hover:text-zinc-100 transition-colors">Blog</a>
						<a href="/tools" class="text-sm font-medium text-stone-600 dark:text-zinc-400 hover:text-stone-900 dark:hover:text-zinc-100 transition-colors">Tools</a>
						<a href="/rss.xml" class="text-sm font-medium text-stone-600 dark:text-zinc-400 hover:text-stone-900 dark:hover:text-zinc-100 transition-colors">RSS</a>
						<a href="/about" class="text-sm font-medium text-stone-600 dark:text-zinc-400 hover:text-stone-900 dark:hover:text-zinc-100 transition-colors">About</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>